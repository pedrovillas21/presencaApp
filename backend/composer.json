{
  "name": "presenca-app/backend",
  "description": "API de relatórios do presencaApp em PHP 8.2",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "dompdf/dompdf": "^3.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "PresencaApp\\Pdf\\": "src/pdf/",
      "PresencaApp\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:8080 -t public public/router.php",
    "test": "php tests/run.php",
    "check": [
      "@php -l public/index.php",
      "@php -l public/router.php",
      "@php -l src/Application.php",
      "@php -l src/Config.php",
      "@php -l src/pdf/AttendanceReport.php",
      "@php -l src/Supabase/SupabaseClient.php",
      "@php -l src/Support/Format.php",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
