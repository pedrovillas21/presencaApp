# Usado pelos arquivos Compose da raiz. As variáveis NEXT_PUBLIC_* atendem ao
# perfil "fullstack" e são inlined no bundle do frontend. Para desenvolvimento
# normal do Next.js, use frontend/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# Deploy do backend com docker-compose-prod.yml + Traefik.
APP_ENV=homolog
APP_HOST=hmpresenca.crefito11.gov.br
BACKEND_HOST_PORT=8080
