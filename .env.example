# Usado APENAS pelo perfil "fullstack" do docker-compose (build do frontend).
# As variáveis NEXT_PUBLIC_* são inlined no bundle e por isso entram como
# build args. Para desenvolvimento normal use frontend/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
